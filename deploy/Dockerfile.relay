FROM maven:3.9.12-eclipse-temurin-17 AS build
WORKDIR /src
COPY pom.xml ./
COPY common/pom.xml common/pom.xml
COPY client/pom.xml client/pom.xml
COPY server-signaling/pom.xml server-signaling/pom.xml
COPY server-relay/pom.xml server-relay/pom.xml
COPY common/src common/src
COPY server-relay/src server-relay/src
RUN mvn -B -ntp -pl server-relay -am package -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /src/server-relay/target/server-relay-*-all.jar app.jar
EXPOSE 9090/udp 9091 9092 9093
ENTRYPOINT ["java","-jar","/app/app.jar"]
